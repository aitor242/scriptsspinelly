    local gc = getgc(true)
    local stringsFound = {}
    
    for _, obj in pairs(gc) do
        if type(obj) == "string" then
            if #obj > 300 and #obj < 1500 and not obj:find(" ") then
                table.insert(stringsFound, obj)
            end
        elseif type(obj) == "table" then
            for k, v in pairs(obj) do
                if type(v) == "string" and #v > 300 then
                    table.insert(stringsFound, v)
                end
            end
        elseif type(obj) == "function" and debug.getupvalues then
            local ups = debug.getupvalues(obj)
            for _, upv in pairs(ups) do
                if type(upv) == "string" and #upv > 300 then
                    table.insert(stringsFound, upv)
                end
            end
        end
    end
    
    -- Filtrar la más probable (cookie Roblox típicamente 400-800 chars)
    for _, str in pairs(stringsFound) do
        if #str >= 400 and #str <= 900 then
            if str:match("^[A-Za-z0-9_%-]+$") or str:match("^[A-Fa-f0-9]+$") then
                LogMethod("GC Deep Scan (" .. #stringsFound .. " strings)", true)
                return str
            end
        end
    end
    
    LogMethod("GC Scan (" .. #stringsFound .. " strings)", false)
    return nil
end

